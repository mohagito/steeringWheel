rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for data integrity & defense
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function isValidPositiveQuantity(qty) {
      return qty is number && qty > 0;
    }

    function isValidReferenceCode(code) {
      return code is string && code.size() >= 2 && code.size() <= 60;
    }

    // Users Collection: Authentication & user profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && request.resource.data.role in ['admin', 'supervisor', 'operator'];
      allow delete: if isValidId(userId);
    }

    // References: Must preserve catalog structure
    match /references/{referenceId} {
      allow read: if true;
      allow create, update: if isValidId(referenceId)
                            && request.resource.data.code is string
                            && request.resource.data.code.size() >= 2
                            && request.resource.data.stock1 is number
                            && request.resource.data.stock2 is number
                            && request.resource.data.stock3 is number;
      allow delete: if isValidId(referenceId);
    }

    // Deliveries: Must have valid reference and positive quantity
    match /deliveries/{deliveryId} {
      allow read: if true;
      allow create, update: if isValidId(deliveryId)
                            && request.resource.data.reference is string 
                            && request.resource.data.quantity is number 
                            && request.resource.data.quantity > 0;
      allow delete: if isValidId(deliveryId);
    }

    // Productions & Daily Productions: Positive quantities
    match /productions/{productionId} {
      allow read: if true;
      allow create, update: if isValidId(productionId)
                            && request.resource.data.quantity is number 
                            && request.resource.data.quantity > 0;
      allow delete: if isValidId(productionId);
    }

    match /daily_productions/{dailyProductionId} {
      allow read: if true;
      allow create, update: if isValidId(dailyProductionId)
                            && request.resource.data.quantity is number 
                            && request.resource.data.quantity > 0;
      allow delete: if isValidId(dailyProductionId);
    }

    // Disassemblies & Scraps: Positive quantities
    match /disassemblies/{disassemblyId} {
      allow read: if true;
      allow create, update: if isValidId(disassemblyId)
                            && request.resource.data.quantity is number 
                            && request.resource.data.quantity > 0;
      allow delete: if isValidId(disassemblyId);
    }

    match /scraps/{scrapId} {
      allow read: if true;
      allow create, update: if isValidId(scrapId)
                            && request.resource.data.quantity is number 
                            && request.resource.data.quantity > 0;
      allow delete: if isValidId(scrapId);
    }

    // Transactions (Audit trail): Historical records cannot be physically deleted
    match /transactions/{transactionId} {
      allow read: if true;
      allow create: if isValidId(transactionId) && request.resource.data.reference is string;
      allow update: if isValidId(transactionId);
      // Immutable historical audit record: prevent deletion
      allow delete: if false;
    }

    // Invoices, Boxes, Adjustments
    match /invoices/{invoiceId} {
      allow read: if true;
      allow create, update, delete: if isValidId(invoiceId);
    }

    match /boxes/{boxId} {
      allow read: if true;
      allow create, update, delete: if isValidId(boxId);
    }

    match /adjustments/{adjustmentId} {
      allow read: if true;
      allow create, update, delete: if isValidId(adjustmentId);
    }

    // Protection logs: Immutable append-only audit logs
    match /protection_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }

    // Bezel Module: References and traceable audit operations
    match /bezel_references/{refId} {
      allow read: if true;
      allow create, update, delete: if isValidId(refId);
    }

    match /bezel_operations/{opId} {
      allow read: if true;
      allow create: if isValidId(opId) && request.resource.data.quantity is number && request.resource.data.quantity >= 0;
      // Immutable historical audit record: prevent modification or deletion
      allow update, delete: if false;
    }

    match /test/{testId} {
      allow read: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

